#!/bin/sh
# pre-push - 推送前敏感信息防线:扫描将要推送的 commits 的全部文件
# 参数: <remote> <url>;stdin 每行: <local ref> <local sha> <remote ref> <remote sha>
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
fail=0
while read local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  # 新分支(远端无此 ref)或删除分支
  case "$local_sha" in
    *0000000000000000000000000000000000000000*) continue ;;  # 删除分支
  esac
  if [ -z "$remote_sha" ] || [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # 新分支:扫描该分支与共同祖先之间的全部提交
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
    if [ -n "$base" ]; then
      range="$base..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi
  powershell -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/sanitize_check.ps1" -Mode push -From "$(echo "$range" | cut -d. -f1)" -To "$(echo "$range" | sed 's/.*\.\.//')"
  status=$?
  if [ $status -ne 0 ]; then
    echo "pre-push: SANITIZE-BLOCKED - 推送已取消,请修复后重试"
    fail=1
  fi
done
exit $fail
